{
  "version": 2,
  "builds": [{ "src": "index.js", "use": "@vercel/node" }],
  "routes": [{ "src": "/(.*)", "dest": "index.js" }],
  "crons": [
    {
      "path": "/api/cron/expire-sessions",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/cancel-stale-bookings",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/refund-notifications",
      "schedule": "0 * * * *"
    }
  ]
}
